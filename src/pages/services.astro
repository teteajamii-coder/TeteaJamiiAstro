---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Our Services">
  <section class="hero" style="background: url('/assets/images/services-hero.jpg') no-repeat center center/cover;">
    <div class="container">
      <div class="hero-content text-center animate-on-scroll">
				<h1 class="hero-title"><span class="lang-en">Four Pillars of Justice</span></h1>
				<p class="hero-subtitle"><span class="lang-en">Comprehensive support from crisis to transformation</span></p>
			</div>
		</div>
	</section>

  <section class="overview" style="padding: 4rem 0; background: var(--gray-50);">
    <div class="container">
      <div class="grid grid-2" style="align-items: center; gap: 4rem;">
        <div class="animate-on-scroll">
          <h2 class="section-title">How We Work</h2>
          <p>We believe that true justice requires a holistic approach. It's not enough to win a court case if a survivor has no way to feed her children. It's not enough to provide therapy if the abuser is still threatening her online.</p>
          <p>Our model integrates legal aid, economic empowerment, digital safety, and community advocacy to ensure long-term stability and healing.</p>
        </div>
        <div class="card animate-on-scroll delay-200" style="background: white; border-left: 5px solid var(--justice-blue);">
          <h3 style="color: var(--justice-blue);">Our Impact Model</h3>
          <ul style="list-style: none; margin-top: 1rem;">
            <li style="padding: 0.5rem 0; border-bottom: 1px solid var(--gray-100);">✅ <strong>Crisis Response:</strong> Immediate safety & legal action</li>
            <li style="padding: 0.5rem 0; border-bottom: 1px solid var(--gray-100);">✅ <strong>Stabilization:</strong> Counseling & secure housing</li>
            <li style="padding: 0.5rem 0; border-bottom: 1px solid var(--gray-100);">✅ <strong>Empowerment:</strong> Skills training & business startup</li>
            <li style="padding: 0.5rem 0;">✅ <strong>System Change:</strong> Policy advocacy & precedent</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
	
	<!-- Traditional Justice -->
	<section id="traditional" style="padding: 4rem 0;">
		<div class="container">
			<div class="grid grid-2" style="gap: 3rem; align-items: center;">
				<div>
					<div style="display: inline-block; padding: 0.5rem 1rem; background: rgba(30,64,175,0.1); color: var(--justice-blue); border-radius: var(--radius-full); font-weight: 600; margin-bottom: 1rem;">Pillar 1</div>
					<h2 style="font-size: 2.5rem; margin-bottom: 1.5rem;">Traditional Justice</h2>
					<p style="font-size: 1.125rem; margin-bottom: 1.5rem;">Comprehensive legal aid and support for survivors of gender-based violence, land disputes, inheritance rights, and child protection.</p>
					<ul style="list-style: none; padding: 0;">
						<li style="display: flex; gap: 1rem; margin-bottom: 1rem;">
							<span style="color: var(--justice-blue); font-size: 1.5rem;">✓</span>
							<div><strong>Free Legal Representation</strong><br/>Court cases, documentation, strategic litigation</div>
						</li>
						<li style="display: flex; gap: 1rem; margin-bottom: 1rem;">
							<span style="color: var(--justice-blue); font-size: 1.5rem;">✓</span>
							<div><strong>Trauma Counseling</strong><br/>Licensed therapists, support groups, healing programs</div>
						</li>
						<li style="display: flex; gap: 1rem; margin-bottom: 1rem;">
							<span style="color: var(--justice-blue); font-size: 1.5rem;">✓</span>
							<div><strong>Safe Shelter Referrals</strong><br/>Emergency housing, safety planning, protection orders</div>
						</li>
					</ul>
				</div>
				<div class="card" style="background: linear-gradient(135deg, rgba(30,64,175,0.1) 0%, rgba(30,64,175,0.05) 100%); border: 2px solid var(--justice-blue);">
					<h3 style="color: var(--justice-blue);">📊 Impact 2025</h3>
					<div style="font-size: 3rem; font-weight: 800; color: var(--justice-blue);">450+</div>
					<p>Legal cases handled</p>
					<div style="font-size: 3rem; font-weight: 800; color: var(--justice-blue); margin-top: 1.5rem;">88%</div>
					</ul>
				</div>
				<div class="card" style="background: linear-gradient(135deg, rgba(5,150,105,0.1) 0%, rgba(5,150,105,0.05) 100%); border: 2px solid var(--community-green);">
					<h3 style="color: var(--community-green);">📈 Economic Impact</h3>
					<div style="font-size: 3rem; font-weight: 800; color: var(--community-green);">300+</div>
					<p>People trained in livelihoods</p>
					<div style="font-size: 3rem; font-weight: 800; color: var(--community-green); margin-top: 1.5rem;">150+</div>
					<p>Businesses launched</p>
				</div>
			</div>
		</div>
	</section>
	
	<!-- Policy & Advocacy -->
	<section id="policy" style="padding: 4rem 0; background: var(--gray-50);">
		<div class="container">
			<div class="grid grid-2" style="gap: 3rem; align-items: center;">
				<div class="card" style="background: linear-gradient(135deg, rgba(234,88,12,0.1) 0%, rgba(234,88,12,0.05) 100%); border: 2px solid var(--urgent-orange);">
					<h3 style="color: var(--urgent-orange);">⚖️ Policy Wins</h3>
					<div style="font-size: 3rem; font-weight: 800; color: var(--urgent-orange);">5</div>
					<p>Legislative reforms influenced</p>
					<div style="font-size: 3rem; font-weight: 800; color: var(--urgent-orange); margin-top: 1.5rem;">12</div>
					<p>Strategic litigation cases won</p>
				</div>
				<div>
					<div style="display: inline-block; padding: 0.5rem 1rem; background: rgba(234,88,12,0.1); color: var(--urgent-orange); border-radius: var(--radius-full); font-weight: 600; margin-bottom: 1rem;">Pillar 4</div>
					<h2 style="font-size: 2.5rem; margin-bottom: 1.5rem;">Policy & Advocacy</h2>
					<p style="font-size: 1.125rem; margin-bottom: 1.5rem;">Changing systems through strategic litigation, evidence-based research, and legislative advocacy.</p>
					<ul style="list-style: none; padding: 0;">
						<li style="display: flex; gap: 1rem; margin-bottom: 1rem;">
							<span style="color: var(--urgent-orange); font-size: 1.5rem;">✓</span>
							<div><strong>Strategic Litigation</strong><br/>Precedent-setting cases, constitutional challenges</div>
						</li>
						<li style="display: flex; gap: 1rem; margin-bottom: 1rem;">
							<span style="color: var(--urgent-orange); font-size: 1.5rem;">✓</span>
							<div><strong>Research & Documentation</strong><br/>Data collection, impact studies, policy briefs</div>
						</li>
						<li style="display: flex; gap: 1rem; margin-bottom: 1rem;">
							<span style="color: var(--urgent-orange); font-size: 1.5rem;">✓</span>
							<div><strong>Legislative Advocacy</strong><br/>Bill drafting, parliamentary engagement, coalitions</div>
						</li>
					</ul>
				</div>
			</div>
		</div>
	</section>
</Layout>
