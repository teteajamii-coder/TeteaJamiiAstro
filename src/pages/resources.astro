---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Resources">
	<section class="hero" style="min-height: 50vh;">
		<div class="container">
			<div class="hero-content text-center">
				<h1 class="hero-title"><span class="lang-en">Knowledge is Power</span></h1>
				<p class="hero-subtitle"><span class="lang-en">Free resources to know your rights and protect yourself</span></p>
			</div>
		</div>
	</section>
	
	<section style="padding: 4rem 0;">
		<div class="container">
			<div class="grid grid-2" style="gap: 2rem;">
				<!-- Legal Resources -->
				<div class="card">
					<div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem;">
						<div style="width: 64px; height: 64px; background: var(--justice-blue); border-radius: var(--radius-lg); display: flex; align-items: center; justify-content: center;">
							<svg width="32" height="32" fill="white" viewBox="0 0 24 24">
								<path d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2"/>
							</svg>
						</div>
						<h2 style="margin: 0; color: var(--justice-blue);">Legal Resources</h2>
					</div>
					<ul style="list-style: none; padding: 0;">
						<li style="padding: 1rem 0; border-bottom: 1px solid var(--gray-200);">
							<a href="#" style="display: flex; justify-content: space-between; align-items: center;">
								<span><strong>GBV Survivors' Rights Guide</strong><br/><small style="color: var(--gray-600);">Your legal protections and options</small></span>
								<span>📄</span>
							</a>
						</li>
						<li style="padding: 1rem 0; border-bottom: 1px solid var(--gray-200);">
							<a href="#" style="display: flex; justify-content: space-between; align-items: center;">
								<span><strong>Land & Inheritance Rights</strong><br/><small style="color: var(--gray-600);">Know your property rights</small></span>
								<span>📄</span>
							</a>
						</li>
						<li style="padding: 1rem 0;">
							<a href="#" style="display: flex; justify-content: space-between; align-items: center;">
								<span><strong>Court Process Explained</strong><br/><small style="color: var(--gray-600);">What to expect in legal proceedings</small></span>
								<span>📄</span>
							</a>
						</li>
					</ul>
				</div>
				
				<!-- Digital Safety -->
				<div class="card">
					<div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem;">
						<div style="width: 64px; height: 64px; background: var(--empowerment-purple); border-radius: var(--radius-lg); display: flex; align-items: center; justify-content: center;">
							<svg width="32" height="32" fill="white" viewBox="0 0 24 24">
								<path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z"/>
							</svg>
						</div>
						<h2 style="margin: 0; color: var(--empowerment-purple);">Digital Safety</h2>
					</div>
					<ul style="list-style: none; padding: 0;">
						<li style="padding: 1rem 0; border-bottom: 1px solid var(--gray-200);">
							<a href="#" style="display: flex; justify-content: space-between; align-items: center;">
								<span><strong>Online Harassment Response</strong><br/><small style="color: var(--gray-600);">Steps to take immediately</small></span>
								<span>📄</span>
							</a>
						</li>
						<li style="padding: 1rem 0; border-bottom: 1px solid var(--gray-200);">
							<a href="#" style="display: flex; justify-content: space-between; align-items: center;">
								<span><strong>Privacy Protection Checklist</strong><br/><small style="color: var(--gray-600);">Secure your accounts & data</small></span>
								<span>📄</span>
							</a>
						</li>
						<li style="padding: 1rem 0;">
							<a href="#" style="display: flex; justify-content: space-between; align-items: center;">
								<span><strong>Digital Rights in Kenya</strong><br/><small style="color: var(--gray-600);">Your online legal protections</small></span>
								<span>📄</span>
							</a>
						</li>
					</ul>
				</div>
				
				<!-- Economic Empowerment -->
				<div class="card">
					<div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem;">
						<div style="width: 64px; height: 64px; background: var(--community-green); border-radius: var(--radius-lg); display: flex; align-items: center; justify-content: center;">
							<svg width="32" height="32" fill="white" viewBox="0 0 24 24">
								<path d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
							</svg>
						</div>
						<h2 style="margin: 0; color: var(--community-green);">Economic Empowerment</h2>
					</div>
					<ul style="list-style: none; padding: 0;">
						<li style="padding: 1rem 0; border-bottom: 1px solid var(--gray-200);">
							<a href="#" style="display: flex; justify-content: space-between; align-items: center;">
								<span><strong>Business Startup Guide</strong><br/><small style="color: var(--gray-600);">From idea to launch</small></span>
								<span>📄</span>
							</a>
						</li>
						<li style="padding: 1rem 0; border-bottom: 1px solid var(--gray-200);">
							<a href="#" style="display: flex; justify-content: space-between; align-items: center;">
								<span><strong>Financial Literacy Toolkit</strong><br/><small style="color: var(--gray-600);">Money management basics</small></span>
								<span>📄</span>
							</a>
						</li>
						<li style="padding: 1rem 0;">
							<a href="#" style="display: flex; justify-content: space-between; align-items: center;">
								<span><strong>Training Program Catalog</strong><br/><small style="color: var(--gray-600);">Skills programs available</small></span>
								<span>📄</span>
							</a>
						</li>
					</ul>
				</div>
				
				<!-- Policy Briefs -->
				<div class="card">
					<div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem;">
						<div style="width: 64px; height: 64px; background: var(--urgent-orange); border-radius: var(--radius-lg); display: flex; align-items: center; justify-content: center;">
							<svg width="32" height="32" fill="white" viewBox="0 0 24 24">
								<path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
							</svg>
						</div>
						<h2 style="margin: 0; color: var(--urgent-orange);">Policy & Research</h2>
					</div>
					<ul style="list-style: none; padding: 0;">
						<li style="padding: 1rem 0; border-bottom: 1px solid var(--gray-200);">
							<a href="#" style="display: flex; justify-content: space-between; align-items: center;">
								<span><strong>Annual Impact Report 2025</strong><br/><small style="color: var(--gray-600);">Full program outcomes & data</small></span>
								<span>📄</span>
							</a>
						</li>
						<li style="padding: 1rem 0; border-bottom: 1px solid var(--gray-200);">
							<a href="#" style="display: flex; justify-content: space-between; align-items: center;">
								<span><strong>Digital Safety Policy Brief</strong><br/><small style="color: var(--gray-600);">Legislative recommendations</small></span>
								<span>📄</span>
							</a>
						</li>
						<li style="padding: 1rem 0;">
							<a href="#" style="display: flex; justify-content: space-between; align-items: center;">
								<span><strong>GBV Response Research</strong><br/><small style="color: var(--gray-600);">Evidence-based interventions</small></span>
								<span>📄</span>
							</a>
						</li>
					</ul>
				</div>
			</div>
		</div>
	</section>
	
	<section style="padding: 4rem 0; background: linear-gradient(135deg, var(--justice-blue), var(--empowerment-purple)); color: white; text-align: center;">
		<div class="container">
			<h2 style="color: white; font-size: 2.5rem; margin-bottom: 1rem;">Need a Resource We Don't Have?</h2>
			<p style="font-size: 1.25rem; margin-bottom: 2rem; opacity: 0.95;">Contact us and we'll create it or point you to trusted sources</p>
			<a href="/contact" class="btn btn-lg" style="background: white; color: var(--justice-blue);">Contact Us</a>
		</div>
	</section>
</Layout>
