---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Our Impact">
	<section class="hero" style="background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('/assets/images/impact-hero.png') no-repeat center center/cover;">
		<div class="container">
			<div class="hero-content text-center animate-on-scroll">
				<h1 class="hero-title"><span class="lang-en">Transforming Lives, Changing Systems</span></h1>
				<p class="hero-subtitle"><span class="lang-en">Every survivor supported. Every case won. Every system challenged.</span></p>
			</div>
		</div>
	</section>

	<section class="impact-map" style="padding: 4rem 0;">
		<div class="container">
			<h2 class="section-title text-center animate-on-scroll">Our Geographic Reach</h2>
			<div id="impact-map" class="animate-on-scroll delay-100" style="width: 100%; height: 500px; border-radius: 1rem; box-shadow: var(--shadow-lg); z-index: 1;"></div>
		</div>
	</section>

	<!-- Leaflet Map CSS & JS -->
	<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
	<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
	
	<script>
		// Initialize Impact Map
		document.addEventListener('DOMContentLoaded', () => {
			if (document.getElementById('impact-map')) {
				// @ts-ignore
				const map = L.map('impact-map').setView([-0.0236, 37.9062], 6); // Kenya Center Zoom

				// @ts-ignore
				L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
					maxZoom: 19,
					attribution: '© OpenStreetMap'
				}).addTo(map);

				// Add Markers for Hubs
				const locations = [
					{ lat: -1.2921, lng: 36.8219, title: "Nairobi", desc: "Headquarters & Legal Aid Clinic" },
					{ lat: -4.0435, lng: 39.6682, title: "Mombasa", desc: "Coastal Hub - Digital Safety" },
					{ lat: -0.0917, lng: 34.7680, title: "Kisumu", desc: "Western Hub - Economic Empowerment" },
					{ lat: -0.3031, lng: 36.0800, title: "Nakuru", desc: "Rift Valley Hub - Land Rights" }
				];

				locations.forEach(loc => {
					// @ts-ignore
					L.marker([loc.lat, loc.lng]).addTo(map)
						.bindPopup(`<b>${loc.title}</b><br>${loc.desc}`);
				});
				
				// Optional: Add circles to show impact radius
				locations.forEach(loc => {
					// @ts-ignore
					L.circle([loc.lat, loc.lng], {
						color: '#EA580C',
						fillColor: '#EA580C',
						fillOpacity: 0.2,
						radius: 50000
					}).addTo(map);
				});
			}
		});
	</script>
	
	<section style="padding: 4rem 0;">
		<div class="container">
			<h2 class="section-title text-center animate-on-scroll">2025 Impact Dashboard</h2>
			<div class="grid grid-3">
				<div class="card text-center animate-on-scroll delay-100" style="background: linear-gradient(135deg, rgba(30,64,175,0.05), rgba(30,64,175,0.1)); border: 2px solid var(--justice-blue); transition: transform 0.3s ease;">
					<div class="stat-number" data-target="1000" style="font-size: 4rem; font-weight: 800; color: var(--justice-blue);">0</div>
					<h3>Lives Protected</h3>
					<p>Survivors supported across Kenya</p>
				</div>
				<div class="card text-center animate-on-scroll delay-200" style="background: linear-gradient(135deg, rgba(124,58,237,0.05), rgba(124,58,237,0.1)); border: 2px solid var(--empowerment-purple); transition: transform 0.3s ease;">
					<div class="stat-number" data-target="85" data-suffix="%" style="font-size: 4rem; font-weight: 800; color: var(--empowerment-purple);">0%</div>
					<h3>Success Rate</h3>
					<p>Legal cases won in court</p>
				</div>
				<div class="card text-center animate-on-scroll delay-300" style="background: linear-gradient(135deg, rgba(5,150,105,0.05), rgba(5,150,105,0.1)); border: 2px solid var(--community-green); transition: transform 0.3s ease;">
					<div class="stat-number" data-target="300" data-suffix="+" style="font-size: 4rem; font-weight: 800; color: var(--community-green);">0+</div>
					<h3>Skills Training</h3>
					<p>Economic empowerment programs delivered</p>
				</div>
			</div>
		</div>
	</section>

	<script>
		// Simple count-up animation
		const observerOptions = {
			root: null,
			rootMargin: '0px',
			threshold: 0.1
		};

		const observer = new IntersectionObserver((entries, observer) => {
			entries.forEach(entry => {
				if (entry.isIntersecting) {
					const counters = entry.target.querySelectorAll('.stat-number');
					counters.forEach(counter => {
						const target = +counter.getAttribute('data-target');
						const suffix = counter.getAttribute('data-suffix') || '';
						const duration = 2000; // ms
						const increment = target / (duration / 16); // 60fps
						
						let current = 0;
						const updateCounter = () => {
							current += increment;
							if (current < target) {
								counter.innerText = Math.ceil(current) + suffix;
								requestAnimationFrame(updateCounter);
							} else {
								counter.innerText = target + suffix;
							}
						};
						updateCounter();
					});
					observer.unobserve(entry.target);
				}
			});
		}, observerOptions);

		const dashboard = document.querySelector('.section-title').parentNode;
		if (dashboard) observer.observe(dashboard);
	</script>
	
	<section style="padding: 4rem 0; background: var(--gray-50);">
		<div class="container">
			<h2 class="section-title text-center">Success Stories</h2>
			<div class="grid grid-2" style="gap: 2rem;">
				<div class="card" style="border-left: 4px solid var(--justice-blue); background: white; box-shadow: var(--shadow-sm);">
					<div style="display: flex; gap: 0.5rem; margin-bottom: 1rem;">
						<span style="color: gold; font-size: 1.25rem;">★★★★★</span>
					</div>
					<h3 style="color: var(--justice-blue); margin-bottom: 0.5rem;">Grace's Journey to Justice</h3>
					<p style="font-style: italic; font-size: 1.125rem; margin-bottom: 1rem; line-height: 1.6;">"When I came to Tetea Jamii, I had lost hope. My land had been taken, and I had no resources to fight back. The legal team didn't just file paperwork; they stood by me in court, explained every step, and fought for my children's future. Today, we are back on our land, secure and peaceful. Tetea Jamii gave me back my voice and my dignity."</p>
					<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--gray-100);">
						<p style="font-weight: 700; margin-bottom: 0;">Grace M.</p>
						<p style="color: var(--gray-600); font-size: 0.875rem;">Land Rights Beneficiary, Nairobi</p>
					</div>
				</div>
				
				<div class="card" style="border-left: 4px solid var(--community-green); background: white; box-shadow: var(--shadow-sm);">
					<div style="display: flex; gap: 0.5rem; margin-bottom: 1rem;">
						<span style="color: gold; font-size: 1.25rem;">★★★★★</span>
					</div>
					<h3 style="color: var(--community-green); margin-bottom: 0.5rem;">Sarah's New Beginning</h3>
					<p style="font-style: italic; font-size: 1.125rem; margin-bottom: 1rem; line-height: 1.6;">"After escaping an abusive home, I had nothing. The economic empowerment program taught me tailoring and financial management. With the startup grant, I bought my first sewing machine. Now, I run a shop in the market and employ three other women survivors. Tetea Jamii didn't just save my life; they gave me the power to build a new one."</p>
					<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--gray-100);">
						<p style="font-weight: 700; margin-bottom: 0;">Sarah K.</p>
						<p style="color: var(--gray-600); font-size: 0.875rem;">Entrepreneur & Skills Graduate, Kisumu</p>
					</div>
				</div>
				
				<div class="card" style="border-left: 4px solid var(--empowerment-purple); background: white; box-shadow: var(--shadow-sm);">
					<div style="display: flex; gap: 0.5rem; margin-bottom: 1rem;">
						<span style="color: gold; font-size: 1.25rem;">★★★★★</span>
					</div>
					<h3 style="color: var(--empowerment-purple); margin-bottom: 0.5rem;">Mercy's Digital Shield</h3>
					<p style="font-style: italic; font-size: 1.125rem; margin-bottom: 1rem; line-height: 1.6;">"Cyberbullying almost silenced me. I was afraid to go online or even leave my house. Tetea Jamii's digital safety team helped me report the harassment, secure my accounts, and understand my rights. I've turned my experience into advocacy, teaching other young women how to stay safe in digital spaces."</p>
					<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--gray-100);">
						<p style="font-weight: 700; margin-bottom: 0;">Mercy A.</p>
						<p style="color: var(--gray-600); font-size: 0.875rem;">Digital Justice Advocate, Mombasa</p>
					</div>
				</div>
				
				<div class="card" style="border-left: 4px solid var(--urgent-orange); background: white; box-shadow: var(--shadow-sm);">
					<div style="display: flex; gap: 0.5rem; margin-bottom: 1rem;">
						<span style="color: gold; font-size: 1.25rem;">★★★★★</span>
					</div>
					<h3 style="color: var(--urgent-orange); margin-bottom: 0.5rem;">Systemic Change</h3>
					<p style="font-style: italic; font-size: 1.125rem; margin-bottom: 1rem; line-height: 1.6;">"Our strategic litigation case on spousal consent in land transfer led to a landmark ruling that now protects thousands of women across the country. This is what systemic justice looks like—fighting individual cases that create collective transformation and legal precedents for generations to come."</p>
					<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--gray-100);">
						<p style="font-weight: 700; margin-bottom: 0;">Dr. Amina W.</p>
						<p style="color: var(--gray-600); font-size: 0.875rem;">Executive Director, Tetea Jamii</p>
					</div>
				</div>
			</div>
		</div>
	</section>
	
	<section style="padding: 4rem 0;">
		<div class="container text-center">
			<h2 class="section-title">Geographic Reach</h2>
			<p style="font-size: 1.125rem; margin-bottom: 2rem;">Serving communities across Kenya with regional hubs</p>
				<div class="stat-card animate-on-scroll">
					<h3 class="stat-number" style="color: var(--justice-blue); font-size: 3rem; margin-bottom: 0.5rem;" data-count="5000">0</h3>
					<p style="font-weight: 600;">Lives Protected</p>
					<p style="font-size: 0.9rem;">Survivors supported across Kenya</p>
				</div>
				<div class="stat-card animate-on-scroll delay-100">
					<h3 class="stat-number" style="color: var(--empowerment-purple); font-size: 3rem; margin-bottom: 0.5rem;" data-count="85%">0</h3>
					<p style="font-weight: 600;">Success Rate</p>
					<p style="font-size: 0.9rem;">Legal cases won in court</p>
				</div>
				<div class="stat-card animate-on-scroll delay-200">
					<h3 class="stat-number" style="color: var(--community-green); font-size: 3rem; margin-bottom: 0.5rem;" data-count="12000">0</h3>
					<p style="font-weight: 600;">Skills Training</p>
					<p style="font-size: 0.9rem;">Economic empowerment programs delivered</p>
				</div>
				<div class="card text-center">
					<div style="font-size: 3rem;">📍</div>
					<h3>Nakuru</h3>
					<p style="color: var(--gray-600);">Rift Valley Hub</p>
			</div>
		</div>
	</section>
</Layout>
