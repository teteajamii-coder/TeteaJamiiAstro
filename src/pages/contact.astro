---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us">
	<section class="hero" style="background: url('/assets/images/contact-hero.png') no-repeat center center/cover;">
		<div class="container">
			<div class="hero-content text-center animate-on-scroll">
				<h1 class="hero-title"><span class="lang-en">Get in Touch</span></h1>
				<p class="hero-subtitle"><span class="lang-en">We're here to listen, support, and act</span></p>
			</div>
		</div>
	</section>
	
	<section style="padding: 4rem 0;">
		<div class="container">
			<div class="grid grid-2" style="gap: 3rem;">
				<!-- Contact Form -->
				<div>
					<h2 style="font-size: 2rem; margin-bottom: 1.5rem;">Send Us a Message</h2>
					<form id="contactForm" class="contact-form card animate-on-scroll delay-200">
						<h3 class="mb-2">Send us a Message</h3>
						<div class="form-group">
							<label for="name" class="form-label">Name</label>
							<input type="text" id="name" name="name" class="form-input" placeholder="Your Name" required>
						</div>
						<div class="form-group">
							<label for="email" class="form-label">Email</label>
							<input type="email" id="email" name="email" class="form-input" placeholder="your@email.com" required>
						</div>
						<div class="form-group">
							<label for="subject" class="form-label">Subject</label>
							<input type="text" id="subject" name="subject" class="form-input" placeholder="How can we help?" required>
						</div>
						<div class="form-group">
							<label for="message" class="form-label">Message</label>
							<textarea id="message" name="message" class="form-textarea" placeholder="Write your message here..." required></textarea>
						</div>
						<button type="submit" class="btn btn-primary" style="width: 100%;">Send Message</button>
						<p style="font-size: 0.8rem; color: var(--gray-600); margin-top: 1rem;">* We respect your privacy. All communications are confidential.</p>
					</form>
					<script>
						document.getElementById('contactForm').addEventListener('submit', (e) => {
							e.preventDefault();
							// Simulate sending
							const btn = e.target.querySelector('button');
							const originalText = btn.textContent;
							btn.textContent = 'Sending...';
							btn.disabled = true;
							
							setTimeout(() => {
								window.location.href = '/thank-you';
							}, 1500);
						});
					</script>
				</div>
				
				<!-- Contact Info -->
				<div>
					<h2 style="font-size: 2rem; margin-bottom: 1.5rem;">Contact Information</h2>
					
					<div class="card" style="margin-bottom: 1.5rem;">
						<h3 style="color: var(--justice-blue); display: flex; align-items: center; gap: 0.75rem;">
							<svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
								<path d="M20 15.5c-1.25 0-2.45-.2-3.57-.57a1.02 1.02 0 00-1.02.24l-2.2 2.2a15.045 15.045 0 01-6.59-6.59l2.2-2.21a.96.96 0 00.25-1A11.36 11.36 0 018.5 4c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1 0 9.39 7.61 17 17 17 .55 0 1-.45 1-1v-3.5c0-.55-.45-1-1-1z"/>
							</svg>
							24/7 Emergency Helpline
						</h3>
						<p style="font-size: 1.5rem; font-weight: 700; color: var(--urgent-orange); margin: 0.5rem 0;">+254 700 000 000</p>
						<p style="font-size: 0.875rem; color: var(--gray-600);">For urgent support - available any time</p>
					</div>
					
					<div class="card" style="margin-bottom: 1.5rem;">
						<h3 style="color: var(--empowerment-purple);">Main Office</h3>
						<p style="margin: 0.5rem 0;">📧 <strong>Email:</strong> info@teteajamii.org</p>
						<p style="margin: 0.5rem 0;">📞 <strong>Office:</strong> +254 20 123 4567</p>
						<p style="margin: 0.5rem 0;">📍 <strong>Address:</strong><br/>Tetea Jamii CBO<br/>Nairobi, Kenya</p>
						<p style="margin: 0.5rem 0;">🕐 <strong>Hours:</strong> Mon-Fri, 8:00 AM - 5:00 PM</p>
					</div>
					
					<div class="card">
						<h3 style="color: var(--community-green);">Regional Hubs</h3>
						<ul style="list-style: none; padding: 0;">
							<li style="padding: 0.75rem 0; border-bottom: 1px solid var(--gray-200);">
								<strong>Mombasa</strong><br/>
								<small>+254 41 XXX XXXX</small>
							</li>
							<li style="padding: 0.75rem 0; border-bottom: 1px solid var(--gray-200);">
								<strong>Kisumu</strong><br/>
								<small>+254 57 XXX XXXX</small>
							</li>
							<li style="padding: 0.75rem 0;">
								<strong>Nakuru</strong><br/>
								<small>+254 51 XXX XXXX</small>
							</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</section>
	
	<section style="padding: 4rem 0; background: var(--gray-50);">
		<div class="container text-center">
			<h2 class="section-title">Find Us on Social Media</h2>
			<div style="display: flex; justify-content: center; gap: 2rem; margin-top: 2rem;">
				<a href="#" style="display: flex; flex-direction: column; align-items: center; gap: 0.5rem;">
					<div style="width: 64px; height: 64px; background: var(--justice-blue); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
						<svg width="32" height="32" fill="white" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
					</div>
					<span style="font-weight: 600;">Facebook</span>
				</a>
				<a href="#" style="display: flex; flex-direction: column; align-items: center; gap: 0.5rem;">
					<div style="width: 64px; height: 64px; background: var(--empowerment-purple); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
						<svg width="32" height="32" fill="white" viewBox="0 0 24 24"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
					</div>
					<span style="font-weight: 600;">Twitter</span>
				</a>
				<a href="#" style="display: flex; flex-direction: column; align-items: center; gap: 0.5rem;">
					<div style="width: 64px; height: 64px; background: var(--community-green); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
						<svg width="32" height="32" fill="white" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
					</div>
					<span style="font-weight: 600;">Instagram</span>
				</a>
			</div>
		</div>
	</section>
</Layout>
