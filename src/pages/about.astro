---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About Us">
	<section class="hero" style="background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('/assets/images/home-hero.png') no-repeat center center/cover;">
		<div class="container">
			<div class="hero-content text-center animate-on-scroll">
				<h1 class="hero-title"><span class="lang-en">Our Story</span><span class="lang-sw hidden">Hadithi Yetu</span></h1>
				<p class="hero-subtitle mb-4"><span class="lang-en">Founded by survivors, led by advocates, driving systemic change.</span></p>
			</div>
		</div>
	</section>
	
	<section id="who-we-are" style="padding: 4rem 0;">
...
	<section style="padding: 4rem 0;">
		<div class="container">
			<h2 class="section-title text-center"><span class="lang-en">Leadership Team</span></h2>
			<div class="grid grid-3">
				<div class="card text-center animate-on-scroll">
					<img src="/assets/images/team-placeholder.svg" alt="Dr. Amina Wanjiku" style="width: 120px; height: 120px; border-radius: 50%; margin: 0 auto 1rem; object-fit: cover; border: 4px solid var(--justice-blue);">
					<h3>Dr. Amina Wanjiku</h3>
					<p style="color: var(--empowerment-purple); font-weight: 600; margin-bottom: 0.5rem;">Executive Director</p>
					<p style="font-size: 0.875rem;">Human rights lawyer, 15+ years in GBV litigation</p>
				</div>
				<div class="card text-center animate-on-scroll delay-100">
					<img src="/assets/images/team-placeholder.svg" alt="James Omondi" style="width: 120px; height: 120px; border-radius: 50%; margin: 0 auto 1rem; object-fit: cover; border: 4px solid var(--community-green);">
					<h3>James Omondi</h3>
					<p style="color: var(--community-green); font-weight: 600; margin-bottom: 0.5rem;">Programs Director</p>
					<p style="font-size: 0.875rem;">Community organizer, economic empowerment specialist</p>
				</div>
				<div class="card text-center animate-on-scroll delay-200">
					<img src="/assets/images/team-placeholder.svg" alt="Sarah Muthoni" style="width: 120px; height: 120px; border-radius: 50%; margin: 0 auto 1rem; object-fit: cover; border: 4px solid var(--urgent-orange);">
					<h3>Sarah Muthoni</h3>
					<p style="color: var(--urgent-orange); font-weight: 600; margin-bottom: 0.5rem;">Policy & Advocacy Lead</p>
					<p style="font-size: 0.875rem;">Legislative strategist, digital rights expert</p>
				</div>
			</div>
		</div>
	</section>
</Layout>
