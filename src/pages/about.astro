---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About Us">
	<section class="hero" style="min-height: 50vh;">
		<div class="container">
			<div class="hero-content text-center animate-on-scroll">
				<h1 class="hero-title"><span class="lang-en">Our Story</span><span class="lang-sw hidden">Hadithi Yetu</span></h1>
				<p class="hero-subtitle"><span class="lang-en">Founded by survivors, led by advocates, driving systemic change.</span></p>
			</div>
		</div>
	</section>
	
	<section id="who-we-are" style="padding: 4rem 0;">
		<div class="container">
			<div class="grid grid-2" style="align-items: center; gap: 4rem;">
				<div class="animate-on-scroll">
					<h2 class="section-title"><span class="lang-en">Who We Are</span></h2>
					<p class="mb-2">Tetea Jamii (Swahili for "Protect the Community") is a registered Community-Based Organization (CBO) dedicated to providing holistic access to justice for vulnerable populations in Kenya.</p>
					<p>We believe that legal aid alone is not enough. To truly break cycles of injustice, we must integrate economic empowerment, digital safety, and mental health support.</p>
				</div>
				<div class="card animate-on-scroll delay-200" style="background: linear-gradient(135deg, var(--justice-blue), var(--empowerment-purple)); color: white;">
					<h3 style="color: white;">Our Mission</h3>
					<p style="color: rgba(255,255,255,0.9); font-size: 1.25rem;">To empower survivors of injustice through comprehensive legal, economic, and psychosocial support while advocating for systemic policy reform.</p>
					<h3 style="color: white; margin-top: 2rem;">Our Vision</h3>
					<p style="color: rgba(255,255,255,0.9); font-size: 1.25rem;">A just and equitable society where every individual has the power, resources, and protection to thrive.</p>
				</div>
			</div>
		</div>
	</section>
	
	<section style="padding: 4rem 0; background: var(--gray-50);">
		<div class="container">
			<h2 class="section-title text-center"><span class="lang-en">Our Values</span></h2>
			<div class="grid grid-4">
				<div class="card text-center">
					<div style="font-size: 3rem; margin-bottom: 1rem;">💪</div>
					<h3>Dignity</h3>
					<p>Every person deserves respect and empowerment</p>
				</div>
				<div class="card text-center">
					<div style="font-size: 3rem; margin-bottom: 1rem;">🤝</div>
					<h3>Solidarity</h3>
					<p>Collective action creates lasting change</p>
				</div>
				<div class="card text-center">
					<div style="font-size: 3rem; margin-bottom: 1rem;">⚖️</div>
					<h3>Justice</h3>
					<p>Rights-based, evidence-driven advocacy</p>
				</div>
				<div class="card text-center">
					<div style="font-size: 3rem; margin-bottom: 1rem;">🌱</div>
					<h3>Transformation</h3>
					<p>Systems change, not just individual cases</p>
				</div>
			</div>
		</div>
	</section>
	
	<section style="padding: 4rem 0;">
		<div class="container">
			<h2 class="section-title text-center"><span class="lang-en">Leadership Team</span></h2>
			<div class="grid grid-3">
				<div class="card text-center">
					<div style="width: 120px; height: 120px; background: linear-gradient(135deg, var(--justice-blue), var(--empowerment-purple)); border-radius: 50%; margin: 0 auto 1rem;"></div>
					<h3>Dr. Amina Wanjiku</h3>
					<p style="color: var(--empowerment-purple); font-weight: 600; margin-bottom: 0.5rem;">Executive Director</p>
					<p style="font-size: 0.875rem;">Human rights lawyer, 15+ years in GBV litigation</p>
				</div>
				<div class="card text-center">
					<div style="width: 120px; height: 120px; background: linear-gradient(135deg, var(--community-green), var(--empowerment-purple)); border-radius: 50%; margin: 0 auto 1rem;"></div>
					<h3>James Omondi</h3>
					<p style="color: var(--community-green); font-weight: 600; margin-bottom: 0.5rem;">Programs Director</p>
					<p style="font-size: 0.875rem;">Community organizer, economic empowerment specialist</p>
				</div>
				<div class="card text-center">
					<div style="width: 120px; height: 120px; background: linear-gradient(135deg, var(--urgent-orange), var(--empowerment-purple)); border-radius: 50%; margin: 0 auto 1rem;"></div>
					<h3>Sarah Muthoni</h3>
					<p style="color: var(--urgent-orange); font-weight: 600; margin-bottom: 0.5rem;">Policy & Advocacy Lead</p>
					<p style="font-size: 0.875rem;">Legislative strategist, digital rights expert</p>
				</div>
			</div>
		</div>
	</section>
</Layout>
