---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Digital Safety">
	<section class="hero" style="background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('/assets/images/home-hero.png') no-repeat center center/cover;">
		<div class="container">
			<div class="hero-content text-center animate-on-scroll">
				<h1 class="hero-title"><span class="lang-en">Digital Safety</span></h1>
				<p class="hero-subtitle" style="color: white;"><span class="lang-en">Protecting women in the digital age.</span></p>
			</div>
		</div>
	</section>

	<section style="padding: 4rem 0;">
		<div class="container">
			<div class="grid grid-2" style="gap: 4rem;">
				<div>
					<h2 class="section-title">Stopping Online Violence</h2>
					<p>Technology-Facilitated Gender-Based Violence (TFGBV) is on the rise. We provide rapid response and long-term advocacy to make the internet safer for women.</p>
					
					<div style="margin-top: 2rem;">
						<div style="background: #eef2ff; padding: 1.5rem; border-left: 4px solid var(--justice-blue); margin-bottom: 1rem;">
							<h4 style="color: var(--justice-blue); margin-bottom: 0.5rem;">Cyberstalking & Harassment</h4>
							<p style="font-size: 0.9rem; margin: 0;">Legal support for victims of online harassment and non-consensual image sharing.</p>
						</div>
						<div style="background: #eef2ff; padding: 1.5rem; border-left: 4px solid var(--justice-blue);">
							<h4 style="color: var(--justice-blue); margin-bottom: 0.5rem;">Digital Hygiene Workshops</h4>
							<p style="font-size: 0.9rem; margin: 0;">Training communities on secure passwords, 2FA, and identifying phishing attempts.</p>
						</div>
					</div>
				</div>
				<div style="display: flex; align-items: center; justify-content: center; background: var(--gray-100); border-radius: var(--radius-lg); padding: 2rem;">
					<div class="text-center">
						<span style="font-size: 5rem;">🛡️💻</span>
						<h3>Report an Incident</h3>
						<p>If you are facing online safety threats, our digital helpline is open.</p>
						<a href="/contact" class="btn btn-primary">Contact Support</a>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>
