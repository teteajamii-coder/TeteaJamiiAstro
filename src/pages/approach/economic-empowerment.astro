---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Economic Empowerment">
	<section class="hero" style="background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('/assets/images/home-hero.png') no-repeat center center/cover;">
		<div class="container">
			<div class="hero-content text-center animate-on-scroll">
				<h1 class="hero-title"><span class="lang-en">Economic Empowerment</span></h1>
				<p class="hero-subtitle" style="color: white;"><span class="lang-en">Building financial independence for sustainable freedom.</span></p>
			</div>
		</div>
	</section>

	<section style="padding: 4rem 0;">
		<div class="container">
			<h2 class="section-title text-center">From Survival to Sustainability</h2>
			<p class="text-center" style="max-width: 800px; margin: 0 auto 3rem;">Financial dependence is often the biggest barrier to leaving abusive situations. Our programs are designed to give women the skills and resources they need to stand on their own.</p>
			
			<div class="grid grid-3">
				<div class="card text-center">
					<div class="card-icon purple" style="margin: 0 auto 1.5rem;">🛠️</div>
					<h3>Skills Training</h3>
					<p>Vocational training in tailoring, beadwork, urban farming, and digital literacy to create marketable skills.</p>
				</div>
				<div class="card text-center">
					<div class="card-icon purple" style="margin: 0 auto 1.5rem;">💼</div>
					<h3>Micro-Business Support</h3>
					<p>We provide seed capital and mentorship to help women start small businesses, ensuring long-term income.</p>
				</div>
				<div class="card text-center">
					<div class="card-icon purple" style="margin: 0 auto 1.5rem;">📈</div>
					<h3>Table Banking</h3>
					<p>Community-led savings and loan groups (Chamas) that foster financial discipline and community support.</p>
				</div>
			</div>
		</div>
	</section>
</Layout>
