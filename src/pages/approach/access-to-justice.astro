---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Access to Justice">
	<section class="hero" style="background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('/assets/images/approach.jpg') no-repeat center center/cover;">
		<div class="container">
			<div class="hero-content text-center animate-on-scroll">
				<h1 class="hero-title"><span class="lang-en">Access to Justice</span><span class="lang-sw hidden">Upatikanaji wa Haki</span></h1>
				<p class="hero-subtitle" style="color: white;"><span class="lang-en">Ensuring every woman has the legal defense she deserves.</span></p>
			</div>
		</div>
	</section>

	<section style="padding: 4rem 0;">
		<div class="container">
			<div class="grid grid-2" style="gap: 4rem; align-items: center;">
				<div>
					<h2 class="section-title">Legal Representation</h2>
					<p>We provide free legal representation for survivors of Gender-Based Violence (GBV). Our team of dedicated lawyers ensures that survivors can navigate the complex legal system without the burden of cost.</p>
					<ul style="list-style: none; padding: 0; margin-top: 1.5rem;">
						<li style="margin-bottom: 1rem; display: flex; gap: 1rem; align-items: center;">
							<span style="background: var(--justice-blue); color: white; width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.8rem;">✓</span>
							<span>Court Representation</span>
						</li>
						<li style="margin-bottom: 1rem; display: flex; gap: 1rem; align-items: center;">
							<span style="background: var(--justice-blue); color: white; width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.8rem;">✓</span>
							<span>Legal Advisory & Counseling</span>
						</li>
						<li style="margin-bottom: 1rem; display: flex; gap: 1rem; align-items: center;">
							<span style="background: var(--justice-blue); color: white; width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.8rem;">✓</span>
							<span>Alternative Dispute Resolution</span>
						</li>
					</ul>
				</div>
				<div style="background: var(--gray-100); padding: 2rem; border-radius: var(--radius-lg);">
					<h3>Paralegal Training</h3>
					<p>We train community paralegals who serve as first responders. They are equipped with knowledge on human rights, family law, and referral pathways.</p>
					<p><strong>Impact:</strong> Over 500 cases resolved at the community level through mediation led by our paralegals.</p>
				</div>
			</div>
		</div>
	</section>

	<section style="background: var(--gray-50); padding: 4rem 0;">
		<div class="container text-center">
			<h2 class="section-title">Strategic Litigation</h2>
			<p style="max-width: 700px; margin: 0 auto 2rem;">We don't just fight individual cases; we fight for systemic change. Tetea Jamii engages in Public Interest Litigation to challenge discriminatory laws and practices.</p>
			<a href="/contact" class="btn btn-primary">Request Legal Aid</a>
		</div>
	</section>
</Layout>
