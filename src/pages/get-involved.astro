---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Get Involved">
	<section class="hero" style="background: url('/assets/images/get-involved-hero.png') no-repeat center center/cover;">
		<div class="container">
			<div class="hero-content text-center animate-on-scroll">
				<h1 class="hero-title"><span class="lang-en">Join the Movement for Justice</span></h1>
				<p class="hero-subtitle"><span class="lang-en">Every contribution creates change. Every voice amplifies justice.</span></p>
			</div>
		</div>
	</section>
	
	<!-- Donate Section -->
	<section id="donate" style="padding: 4rem 0;">
		<div class="container">
			<h2 class="section-title text-center animate-on-scroll">💰 <span class="lang-en">Donate to Fund Justice</span></h2>
			<div class="grid grid-3" style="gap: 2rem; max-width: 1000px; margin: 0 auto;">
				<div class="card text-center animate-on-scroll delay-100" style="border: 2px solid var(--justice-blue);">
					<h3 style="color: var(--justice-blue);">KSh 5,000</h3>
					<p style="font-size: 0.875rem; margin: 1rem 0;">Provides legal consultation for 1 survivor</p>
					<button class="btn btn-primary donate-trigger" style="width: 100%;">Donate Now</button>
				</div>
				<div class="card text-center animate-on-scroll delay-200" style="border: 3px solid var(--empowerment-purple); transform: scale(1.05);">
					<div style="background: var(--empowerment-purple); color: white; padding: 0.5rem; margin: -1.5rem -1.5rem 1rem -1.5rem; border-radius: var(--radius-lg) var(--radius-lg) 0 0;">Most Popular</div>
					<h3 style="color: var(--empowerment-purple);">KSh 15,000</h3>
					<p style="font-size: 0.875rem; margin: 1rem 0;">Funds full legal representation for 1 case</p>
					<button class="btn btn-purple donate-trigger" style="width: 100%;">Donate Now</button>
				</div>
				<div class="card text-center animate-on-scroll delay-300" style="border: 2px solid var(--community-green);">
					<h3 style="color: var(--community-green);">KSh 50,000</h3>
					<p style="font-size: 0.875rem; margin: 1rem 0;">Sponsors 10 women in skills training program</p>
					<button class="btn btn-green donate-trigger" style="width: 100%;">Donate Now</button>
				</div>
			</div>
			
			<div style="text-align: center; margin-top: 2rem;">
				<p style="font-size: 1.125rem; margin-bottom: 1rem;">Or make a custom donation:</p>
				<div class="grid grid-2" style="gap: 4rem; align-items: center;">
				<div class="animate-on-scroll">
					<h2 class="section-title">Support Our Work</h2>
					<p>Your contribution directly supports survivors. 100% of individual donations go to legal fees, emergency shelter costs, and skills training supplies.</p>
					
					<div class="donation-options" style="margin-top: 2rem; display: flex; gap: 1rem; flex-wrap: wrap;">
						<button id="mpesa-btn" class="btn btn-primary" style="background: #4CAF50;">
							Donate via M-Pesa
						</button>
						<a href="https://www.paypal.com/donate" target="_blank" class="btn btn-primary" style="background: #0070BA;">
							Donate via PayPal
						</a>
					</div>

					<!-- M-Pesa Modal -->
					<div id="mpesa-modal" class="modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1001; align-items: center; justify-content: center;">
						<div class="modal-content" style="background: white; padding: 2rem; border-radius: 1rem; max-width: 400px; width: 90%; position: relative;">
							<button class="modal-close" style="position: absolute; top: 1rem; right: 1rem; background: none; border: none; font-size: 1.5rem; cursor: pointer;">&times;</button>
							<h3 style="color: #4CAF50; margin-bottom: 1rem;">M-Pesa Paybill</h3>
							<p class="mb-2"><strong>Business No:</strong> 123456</p>
							<p class="mb-2"><strong>Account No:</strong> Your Name</p>
							<p style="font-size: 0.9rem; color: var(--gray-600);">Go to M-Pesa &gt; Lipa na M-Pesa &gt; Paybill. Enter the details above to support us.</p>
						</div>
					</div>

					<script>
						document.addEventListener('DOMContentLoaded', () => {
							const mpesaBtn = document.getElementById('mpesa-btn');
							const donateTriggers = document.querySelectorAll('.donate-trigger'); // Select all donate buttons
							const modal = document.getElementById('mpesa-modal');
							const closeBtn = modal?.querySelector('.modal-close');

							if (modal && closeBtn) {
								// Open modal for main M-Pesa button
								mpesaBtn?.addEventListener('click', () => {
									modal.style.display = 'flex';
								});

								// Open modal for all "Donate Now" pricing buttons
								donateTriggers.forEach(btn => {
									btn.addEventListener('click', () => {
										modal.style.display = 'flex';
									});
								});

								closeBtn.addEventListener('click', () => {
									modal.style.display = 'none';
								});
								modal.addEventListener('click', (e) => {
									if (e.target === modal) modal.style.display = 'none';
								});
							}
						});
					</script>
				</div>
				<div class="animate-on-scroll delay-200">
					<div class="card" style="background: white;">
						<h3>Where Your Money Goes</h3>
						<ul style="list-style: none; margin-top: 1rem;">
							<li style="padding: 0.75rem 0; border-bottom: 1px solid var(--gray-100); display: flex; justify-content: space-between;">
								<span>⚖️ Legal Fees</span>
								<strong>40%</strong>
							</li>
							<li style="padding: 0.75rem 0; border-bottom: 1px solid var(--gray-100); display: flex; justify-content: space-between;">
								<span>🏠 Emergency Shelter</span>
								<strong>25%</strong>
							</li>
							<li style="padding: 0.75rem 0; border-bottom: 1px solid var(--gray-100); display: flex; justify-content: space-between;">
								<span>🌱 Skills Training</span>
								<strong>20%</strong>
							</li>
							<li style="padding: 0.75rem 0; display: flex; justify-content: space-between;">
								<span>📢 Advocacy</span>
								<strong>15%</strong>
							</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</section>
	
	<!-- Volunteer Section -->
	<section id="volunteer" style="padding: 4rem 0; background: var(--gray-50);">
		<div class="container">
			<h2 class="section-title text-center">🤝 <span class="lang-en">Volunteer Your Skills</span></h2>
			<p class="text-center" style="font-size: 1.125rem; max-width: 700px; margin: 0 auto 3rem auto;">Share your time, expertise, and passion to directly impact lives in your community.</p>
			
			<div class="grid grid-2" style="gap: 2rem;">
				<div class="card">
					<h3 style="color: var(--justice-blue);">Legal Volunteers</h3>
					<p>Lawyers, paralegals, law students</p>
					<ul style="font-size: 0.875rem;">
						<li>Pro bono legal representation</li>
						<li>Legal clinics & consultations</li>
						<li>Document drafting support</li>
						<li>Court accompaniment</li>
					</ul>
					<button class="btn btn-primary" style="margin-top: 1rem;">Apply Now</button>
				</div>
				
				<div class="card">
					<h3 style="color: var(--empowerment-purple);">Counseling Volunteers</h3>
					<p>Therapists, social workers, psychologists</p>
					<ul style="font-size: 0.875rem;">
						<li>Trauma counseling sessions</li>
						<li>Support group facilitation</li>
						<li>Crisis intervention</li>
						<li>Mental health workshops</li>
					</ul>
					<button class="btn btn-purple" style="margin-top: 1rem;">Apply Now</button>
				</div>
				
				<div class="card">
					<h3 style="color: var(--community-green);">Training Volunteers</h3>
					<p>Skills trainers, entrepreneurs, mentors</p>
					<ul style="font-size: 0.875rem;">
						<li>Vocational skills teaching</li>
						<li>Business mentorship</li>
						<li>Digital literacy training</li>
						<li>Leadership development</li>
					</ul>
					<button class="btn btn-green" style="margin-top: 1rem;">Apply Now</button>
				</div>
				
				<div class="card">
					<h3 style="color: var(--urgent-orange);">Administrative Volunteers</h3>
					<p>Generalists, students, community members</p>
					<ul style="font-size: 0.875rem;">
						<li>Event organization</li>
						<li>Fundraising campaigns</li>
						<li>Social media management</li>
						<li>Data entry & documentation</li>
					</ul>
					<button class="btn" style="margin-top: 1rem; background: var(--urgent-orange); color: white;">Apply Now</button>
				</div>
			</div>
		</div>
	</section>
	
	<!-- Partner Section -->
	<section id="partner" style="padding: 4rem 0;">
		<div class="container">
			<h2 class="section-title text-center">🤝 <span class="lang-en">Partner With Us</span></h2>
			<div class="grid grid-3">
				<div class="card text-center">
					<div style="font-size: 3rem; margin-bottom: 1rem;">🏢</div>
					<h3>Corporate CSR</h3>
					<p>Align your business with social justice through strategic partnerships</p>
					<ul style="text-align: left; font-size: 0.875rem;">
						<li>Cause marketing campaigns</li>
						<li>Employee volunteering</li>
						<li>Matched giving programs</li>
						<li>In-kind donations</li>
					</ul>
					<button class="btn btn-primary" style="margin-top: 1rem;">Partner Inquiry</button>
				</div>
				
				<div class="card text-center">
					<div style="font-size: 3rem; margin-bottom: 1rem;">🌍</div>
					<h3>NGO Collaboration</h3>
					<p>Join forces with other organizations for greater impact</p>
					<ul style="text-align: left; font-size: 0.875rem;">
						<li>Joint programming</li>
						<li>Resource sharing</li>
						<li>Policy coalitions</li>
						<li>Knowledge exchange</li>
					</ul>
					<button class="btn btn-primary" style="margin-top: 1rem;">Partner Inquiry</button>
				</div>
				
				<div class="card text-center">
					<div style="font-size: 3rem; margin-bottom: 1rem;">🏛️</div>
					<h3>Government Agencies</h3>
					<p>Collaborate on policy, service delivery, and systemic reform</p>
					<ul style="text-align: left; font-size: 0.875rem;">
						<li>Technical assistance</li>
						<li>Data sharing</li>
						<li>Capacity building</li>
						<li>Legislative advocacy</li>
					</ul>
					<button class="btn btn-primary" style="margin-top: 1rem;">Partner Inquiry</button>
				</div>
			</div>
		</div>
	</section>
</Layout>
