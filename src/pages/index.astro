---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
  <section class="hero" style="background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('/assets/images/home-hero.png') no-repeat center center/cover;">
    <div class="container">
      <div class="hero-content text-center animate-on-scroll">
				<h1 class="hero-title">Building a Kenya Where Justice Protects Everyone</h1>
				<p class="hero-subtitle mb-4" style="color: white; opacity: 1;">Comprehensive legal aid, digital safety, economic empowerment, and systemic transformation</p>
				<div style="display: flex; gap: 1rem; justify-content: center; margin-top: 2rem;">
					<a href="/get-help" class="btn btn-primary btn-lg">Get Help Now</a>
					<a href="/get-involved" class="btn btn-secondary btn-lg" style="color: white; border-color: white;">Join Us</a>
				</div>
      </div>
    </div>
  </section>

  <!-- Impact Stats -->
  <section class="stats-section" style="background: var(--justice-blue); color: white; padding: 3rem 0;">
    <div class="container">
      <div class="grid grid-4 text-center">
        <div class="stat-item animate-on-scroll">
          <h3 class="stat-number">5,000+</h3>
          <p>Women Represented</p>
        </div>
        <div class="stat-item animate-on-scroll delay-100">
          <h3 class="stat-number">12,000</h3>
          <p>Community Members Trained</p>
        </div>
        <div class="stat-item animate-on-scroll delay-200">
          <h3 class="stat-number">85%</h3>
          <p>Case Win Rate</p>
        </div>
        <div class="stat-item animate-on-scroll delay-300">
          <h3 class="stat-number">47</h3>
          <p>Counties Reached</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Holistic Approach -->
  <section id="approach" style="padding: 4rem 0;">
    <div class="container">
      <div class="section-header animate-on-scroll">
        <h2 class="section-title">Our Holistic Approach</h2>
        <p class="section-subtitle">Justice is not just legal—it's economic, social, and digital.</p>
      </div>
      
      <div class="grid grid-3">
        <div class="card animate-on-scroll delay-100">
          <div class="card-icon blue">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path></svg>
          </div>
          <h3>Access to Justice</h3>
          <p>Pro bono legal representation and paralegal support for survivors of gender-based violence and land injustice.</p>
          <a href="/approach/access-to-justice" class="btn-link">Learn more &rarr;</a>
        </div>

        <div class="card animate-on-scroll delay-200">
          <div class="card-icon purple">
           <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          </div>
          <h3>Economic Empowerment</h3>
          <p>Skills training and seed funding to help survivors build independent, sustainable livelihoods.</p>
          <a href="/approach/economic-empowerment" class="btn-link">Learn more &rarr;</a>
        </div>

        <div class="card animate-on-scroll delay-300">
           <div class="card-icon green">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
           </div>
          <h3>Digital Safety</h3>
          <p>Training and rapid response for women facing online harassment and technology-facilitated abuse.</p>
          <a href="/approach/digital-safety" class="btn-link">Learn more &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background: var(--gray-50); padding: 4rem 0; text-center;">
    <div class="container animate-on-scroll">
      <h2 class="section-title text-center">Ready to Make an Impact?</h2>
      <p style="max-width: 600px; margin: 0 auto 2rem;">Join us in building a safer, more just Kenya.</p>
      <div style="display: flex; justify-content: center; gap: 1rem;">
        <a href="/get-involved" class="btn btn-primary">Donate Now</a>
        <a href="/get-involved" class="btn btn-secondary">Volunteer</a>
      </div>
    </div>
  </section>
</Layout>
