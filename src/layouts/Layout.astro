---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title} | Tetea Jamii - Protect the Community</title>
		<meta name="description" content="Comprehensive justice, healing, and empowerment for Kenya's vulnerable communities" />
		<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🛡️</text></svg>" />
		<link rel="stylesheet" href="/assets/css/styles.css" />
	</head>
	<body>
		<!-- Skip to main content -->
		<a href="#main-content" class="skip-link">Skip to main content</a>

		<!-- Quick Exit Button -->
		<button id="quick-exit" class="quick-exit" aria-label="Quick exit">
			<svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
			</svg>
			<span class="lang-en">Quick Exit</span>
			<span class="lang-sw hidden">Toka Haraka</span>
		</button>

		<!-- Emergency Helpline Bar -->
		<div class="emergency-bar">
			<div class="container emergency-content">
				<div class="helpline-info">
					<svg width="32" height="32" fill="currentColor" viewBox="0 0 24 24">
						<path d="M20 15.5c-1.25 0-2.45-.2-3.57-.57a1.02 1.02 0 00-1.02.24l-2.2 2.2a15.045 15.045 0 01-6.59-6.59l2.2-2.21a.96.96 0 00.25-1A11.36 11.36 0 018.5 4c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1 0 9.39 7.61 17 17 17 .55 0 1-.45 1-1v-3.5c0-.55-.45-1-1-1z"></path>
					</svg>
					<div>
						<p style="margin: 0; font-size: 0.875rem; opacity: 0.9;">
							<span class="lang-en">24/7 Emergency Helpline</span>
							<span class="lang-sw hidden">Simu ya Dharura ya Masaa 24</span>
						</p>
						<p class="helpline-number" style="margin: 0;">+254 700 000 000</p>
					</div>
				</div>

				<div class="emergency-actions">
					<a href="/get-help" class="btn-emergency">
						<span class="lang-en">Get Help Now</span>
						<span class="lang-sw hidden">Pata Msaada Sasa</span>
					</a>
					<button id="lang-toggle" class="btn-lang-toggle">EN / SW</button>
				</div>
			</div>
		</div>

		<!-- Main Navigation -->
		<nav class="main-nav">
			<div class="container nav-container">
				<a href="/" class="logo">
					🛡️ <span>Tetea Jamii</span>
				</a>

				<ul class="nav-links">
					<li><a href="/"><span class="lang-en">Home</span><span class="lang-sw hidden">Nyumbani</span></a></li>
					<li><a href="/about"><span class="lang-en">About</span><span class="lang-sw hidden">Kuhusu</span></a></li>
					<li><a href="/services"><span class="lang-en">Services</span><span class="lang-sw hidden">Huduma</span></a></li>
					<li><a href="/impact"><span class="lang-en">Impact</span><span class="lang-sw hidden">Athari</span></a></li>
					<li><a href="/get-involved"><span class="lang-en">Get Involved</span><span class="lang-sw hidden">Jiunga</span></a></li>
					<li><a href="/resources"><span class="lang-en">Resources</span><span class="lang-sw hidden">Rasilimali</span></a></li>
					<li><a href="/contact"><span class="lang-en">Contact</span><span class="lang-sw hidden">Wasiliana</span></a></li>
				</ul>

				<button class="mobile-menu-toggle" aria-label="Toggle menu">
					<span></span><span></span><span></span>
				</button>
			</div>
		</nav>

		<main id="main-content">
			<slot />
		</main>

		<!-- Footer -->
		<footer class="footer">
			<div class="container">
				<div class="footer-grid">
					<div class="footer-section">
						<div class="logo" style="color: white; margin-bottom: var(--spacing-md);">
							🛡️ <span>Tetea Jamii</span>
						</div>
						<p style="color: var(--gray-300);">
							<span class="lang-en">Protecting communities through comprehensive justice</span>
							<span class="lang-sw hidden">Kulinda jamii kupitia haki kamili</span>
						</p>
					</div>

					<div class="footer-section">
						<h4><span class="lang-en">Quick Links</span></h4>
						<ul class="footer-links">
							<li><a href="/about">About</a></li>
							<li><a href="/services">Services</a></li>
							<li><a href="/impact">Impact</a></li>
						</ul>
					</div>

					<div class="footer-section">
						<h4><span class="lang-en">Get Involved</span></h4>
						<ul class="footer-links">
							<li><a href="/get-help">Get Help</a></li>
							<li><a href="/get-involved">Donate</a></li>
							<li><a href="/get-involved">Volunteer</a></li>
						</ul>
					</div>

					<div class="footer-section">
						<h4><span class="lang-en">Contact</span></h4>
						<ul class="footer-links">
							<li>📞 +254 700 000 000</li>
							<li>✉️ info@teteajamii.org</li>
							<li>📍 Nairobi, Kenya</li>
						</ul>
					</div>
				</div>

				<div class="footer-bottom">
					<p style="margin: 0;">&copy; 2026 Tetea Jamii. All rights reserved.</p>
				</div>
			</div>
		</footer>

		<script is:inline src="/assets/js/main.js"></script>
		<script>
			// Global Scroll Animation Observer
			document.addEventListener('DOMContentLoaded', () => {
				const observerOptions = {
					root: null,
					rootMargin: '0px',
					threshold: 0.1
				};

				const observer = new IntersectionObserver((entries, observer) => {
					entries.forEach(entry => {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target); // Only animate once
						}
					});
				}, observerOptions);

				const animatedElements = document.querySelectorAll('.animate-on-scroll');
				animatedElements.forEach(el => observer.observe(el));
			});
		</script>
	</body>
</html>
